MANNY_ENV=raspberrypi
MANNY_CONFIG_PROFILE=raspberrypi
MANNY_DEVICE_ID=manny-pi5
MANNY_USER_TIMEZONE=UTC
MANNY_AUDIO_DEVICE=default
MANNY_MCP_URL=https://your-money-copilot.example/mcp
MANNY_MCP_ALLOWED_TOOLS=get_budget_status,summarize_expenses

# Voice: set to true only after verifying the microphone with scripts/verify_hardware.sh.
# The loop listens continuously and is gated by local voice-activity detection only;
# wake-word gating is not yet wired.
MANNY_VOICE_LOOP_ENABLED=false
MANNY_VOICE_CAPTURE_SECONDS=3.0
MANNY_VOICE_VAD_THRESHOLD=0.02

# Presence: opencv_hog needs python3-opencv on the device. Presence stays 0 with "none".
MANNY_PERSON_DETECTOR=none
