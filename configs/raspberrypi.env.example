MANNY_ENV=raspberrypi
MANNY_CONFIG_PROFILE=raspberrypi
MANNY_DEVICE_ID=manny-pi5
MANNY_USER_TIMEZONE=UTC
MANNY_AUDIO_DEVICE=default
MANNY_MCP_URL=https://your-money-copilot.example/mcp
MANNY_MCP_ALLOWED_TOOLS=get_budget_status,summarize_expenses

# Voice: on by default. Verify the microphone with scripts/verify_hardware.sh.
MANNY_VOICE_LOOP_ENABLED=true
MANNY_VOICE_CAPTURE_SECONDS=3.0
MANNY_VOICE_VAD_THRESHOLD=0.02

# Wake phrase. Required in any shared room: without it Manny replies to every
# conversation within earshot. Follow-up seconds keep it listening after a reply
# so you need not repeat the phrase.
MANNY_WAKE_WORD_ENABLED=true
MANNY_WAKE_WORD_PHRASES=hey manny,hi manny,ok manny,hello manny
MANNY_WAKE_FOLLOW_UP_SECONDS=8

# Recognition language. "auto" leaves whisper.cpp to identify the language from a
# short chunk, which it does poorly for Bangla. Set the language you speak — for
# example bn-BD — and both recognition and the spoken reply follow it.
MANNY_VOICE_DEFAULT_LANGUAGE=bn-BD

# Presence: opencv_hog needs python3-opencv on the device. Presence stays 0 with "none".
MANNY_PERSON_DETECTOR=none

# Scene description needs a vision-capable model served by llama-server. Measure
# it on the Pi before enabling: a 4B multimodal model is a different memory and
# latency budget than the 1B text model.
MANNY_VISION_LANGUAGE_BACKEND=none
MANNY_VISION_LANGUAGE_MODEL=gemma-3-4b-it
