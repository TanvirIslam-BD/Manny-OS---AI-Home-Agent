MANNY_ENV=development
MANNY_CONFIG_PROFILE=development
MANNY_DEVICE_ID=dev-manny
MANNY_USER_TIMEZONE=UTC

MANNY_API_HOST=127.0.0.1
MANNY_API_PORT=8765
MANNY_LOG_LEVEL=INFO

MANNY_HARDWARE_MODE=mock
MANNY_AUDIO_DEVICE=
MANNY_LED_STATE_PATH=
MANNY_DISPLAY_BRIGHTNESS_PATH=
MANNY_MCP_MODE=mock
MANNY_MCP_URL=
MANNY_MCP_PROTOCOL_VERSION=2026-07-28
MANNY_MCP_ACCESS_TOKEN=
MANNY_MCP_TOKEN_STORAGE=json
MANNY_MCP_CONNECT_TIMEOUT_SECONDS=45
MANNY_MCP_TOOL_TIMEOUT_SECONDS=30
MANNY_MCP_ALLOWED_TOOLS=

MANNY_STT_BACKEND=mock
# Desktop speech output falls back to browser voices, which are whatever the host
# operating system installed — a default Windows install has none outside English, so
# a Bengali or Hindi reply is shown and never spoken. Set this to espeak_ng, with
# eSpeak NG installed locally, to have the simulator speak every language the device
# does. Requires no path below: an espeak-ng on PATH is found wherever it lives.
MANNY_TTS_BACKEND=mock
MANNY_VOICE_DEFAULT_LANGUAGE=auto
MANNY_WHISPER_CPP_BINARY=/opt/manny/whisper.cpp/build/bin/whisper-cli
MANNY_WHISPER_CPP_MODEL=/opt/manny/models/ggml-base.bin
MANNY_WHISPER_CPP_THREADS=4
MANNY_WHISPER_CPP_TIMEOUT_SECONDS=90
# Where the Pi installer puts it. Set this only if eSpeak NG is somewhere PATH does
# not reach, such as a Windows install you chose not to add to PATH.
MANNY_ESPEAK_NG_BINARY=/usr/bin/espeak-ng
# Speaker identifier for backends that select one. eSpeak NG picks its voice from the
# language tag and ignores this. Kokoro requires an identifier from its own catalogue
# and fails without one, so set it if you switch MANNY_TTS_BACKEND to kokoro.
MANNY_TTS_VOICE=
MANNY_LLM_BACKEND=mock
MANNY_LLM_BASE_URL=http://127.0.0.1:11434
MANNY_LLM_MODEL=gemma3n:e2b
MANNY_LLM_TIMEOUT_SECONDS=60
MANNY_LLM_MAX_TOKENS=320
MANNY_LLM_CONTEXT_TURNS=6
# Speak each sentence as the model produces it rather than waiting for the whole
# reply. This is the largest remaining source of perceived latency in a spoken turn.
MANNY_LLM_STREAM_REPLIES=true

MANNY_DISPLAY_WIDTH=480
MANNY_DISPLAY_HEIGHT=480
MANNY_DISPLAY_ROTATION=0
MANNY_DISPLAY_SCALE=1.0

# Device listen loop. On by default; runs only when MANNY_HARDWARE_MODE=real.
MANNY_VOICE_LOOP_ENABLED=true
MANNY_VOICE_VAD_THRESHOLD=0.02

# End the utterance when the speaker stops, not when a timer expires. With this off
# the recorder stops after MANNY_VOICE_CAPTURE_SECONDS, which cuts any question
# longer than the window and makes short ones wait out the remainder. Recorders that
# cannot stream frames — the mocks and the desktop simulator — use the window
# regardless, so CAPTURE_SECONDS still matters there.
MANNY_VOICE_ENDPOINTING_ENABLED=true
MANNY_VOICE_CAPTURE_SECONDS=3.0
MANNY_VOICE_FRAME_SECONDS=0.1
# Trailing silence that ends a turn. Lower interrupts a pause for thought; higher
# makes every answer feel late.
MANNY_VOICE_SILENCE_HOLD_SECONDS=0.8
MANNY_VOICE_MAX_UTTERANCE_SECONDS=12.0

# Wake phrase. With this off the device answers any speech it hears.
MANNY_WAKE_WORD_ENABLED=true
MANNY_WAKE_WORD_PHRASES=hey manny,hi manny,ok manny,hello manny
MANNY_WAKE_FOLLOW_UP_SECONDS=8

MANNY_CAMERA_ENABLED=true
# none | opencv_hog — presence stays 0 until a detector is selected.
MANNY_PERSON_DETECTOR=none

# Scene description: answering "what do you see". Needs a model whose vision encoder
# the runtime actually exposes — `ollama show` reports whether a tag advertises it.
# Shares the daemon and, for a multimodal tag, the model with conversation. Frames are
# held in memory and dropped after the answer; nothing is written or sent off-device.
MANNY_VISION_LANGUAGE_BACKEND=none
MANNY_VISION_LANGUAGE_BASE_URL=http://127.0.0.1:11434
MANNY_VISION_LANGUAGE_MODEL=gemma3n:e2b
MANNY_VISION_LANGUAGE_TIMEOUT_SECONDS=120
MANNY_FACE_RECOGNITION_ENABLED=false

MANNY_QUIET_HOURS_START=22:00
MANNY_QUIET_HOURS_END=07:00
