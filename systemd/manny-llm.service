[Unit]
Description=Manny Local Gemma 3 Agent
After=local-fs.target

[Service]
Type=simple
User=manny
Group=manny
WorkingDirectory=/opt/manny
# install_gemma_pi.sh writes the model it actually downloaded here. Do not hardcode
# a filename in ExecStart: the unit and the installer drifted apart once already.
# A missing file means Gemma was never installed — run install_gemma_pi.sh first.
EnvironmentFile=/opt/manny/model.env
# Text only while the camera is deferred. To enable scene description, install the
# 4B variant with its projector and add:
#   --mmproj /opt/manny/models/gemma-3-4b-it-mmproj-F16.gguf
# --threads 4 matches the Pi 5's four Cortex-A76 cores; more oversubscribes them.
# --cache-reuse lets llama.cpp salvage the KV cache when the oldest conversation
# turn falls out of the window and shifts the prompt, instead of re-evaluating the
# whole prefix. The system instruction leads and never varies, so it stays cached.
ExecStart=/opt/manny/llama.cpp/build/bin/llama-server -m ${MANNY_LLM_MODEL_FILE} --alias ${MANNY_LLM_MODEL_ALIAS} --host 127.0.0.1 --port 8080 --ctx-size 4096 --threads 4 --parallel 1 --cache-reuse 256
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
Nice=5
# Headroom for either variant, so switching MANNY_GEMMA_VARIANT cannot silently
# trade a missing-file error for an OOM kill. The 1B default uses far less.
MemoryMax=6G
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
