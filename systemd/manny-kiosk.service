[Unit]
Description=Manny OS Chromium Kiosk
After=manny-core.service graphical.target
Requires=manny-core.service

[Service]
Type=simple
User=manny
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium --kiosk --no-first-run http://127.0.0.1:8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
